# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Playwright
.playwright/

# Runtime artifacts (keep the directories, ignore contents)
logs/*
!logs/.gitkeep
screenshots/*
!screenshots/.gitkeep
downloads/*
!downloads/.gitkeep
database/*.db
database/*.sqlite
database/*.sqlite3

# Generated output — runtime resumes & cover letters are personal (git-ignored),
# but keep the folder structure + guidance in the repo.
generated/*
!generated/resume/
!generated/coverletter/
!generated/outreach/
generated/resume/*
generated/coverletter/*
generated/outreach/*
!generated/resume/.gitkeep
!generated/resume/README.md
!generated/coverletter/.gitkeep
!generated/coverletter/README.md
!generated/outreach/.gitkeep
!generated/outreach/README.md

# Exported application data (may contain personal data)
applications.csv
exports/

# Real secrets (personal config, never commit)
configs/config.yaml
configs/answers.yaml
configs/searches.yaml
configs/question_bank.yaml
.env

# Browser profile - contains your logged-in LinkedIn session (NEVER commit)
.browser-profile/

# IDE
.idea/
.vscode/
*.swp
