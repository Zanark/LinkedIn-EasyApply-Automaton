<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ b.name }} - Resume</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ font_href | safe }}" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
  :root {
    --teal: #2aa198;          /* Solarized cyan — soft seafoam green */
    --ink: #1f2328;
    --muted: #5b6470;
    --rule: #bcc9c6;
    --link: #33403c;

    /* one place to tune every size. body(8) is 2pt under entry-title(10). */
    --fs-body: 8pt;           /* bullets + skills + award detail (2pt under title) */
    --fs-title: 10pt;         /* the "Microsoft, Software Engineer" entry line */
    --fs-headline: 9pt;
    --fs-name: 20pt;
    --fs-section: 11.5pt;
    --fs-meta: 8pt;
    --fs-contacts: 8pt;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: {{ font_stack | safe }};
    color: var(--ink); font-size: var(--fs-body); line-height: 1.4;
    /* force uniform-height, uniform-width digits (kills old-style figures so the
       phone number + dates + percentages don't look like mixed sizes) */
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: "lnum" 1, "tnum" 1;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }

  /* ---------- header: name+headline LEFT, contacts 2x2 grid RIGHT ---------- */
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .name { font-size: var(--fs-name); font-weight: 600; color: var(--teal);
          line-height: 1.02; letter-spacing: .2px; margin-left: -1px; }  /* nudged 1px left */
  .headline { font-size: var(--fs-headline); color: var(--ink); margin-top: 2px; }
  .contacts { display: grid; grid-template-rows: auto auto; grid-auto-flow: column;
              column-gap: 22px; row-gap: 5px; padding-top: 4px;
              font-size: var(--fs-contacts); color: var(--link); }
  .contacts > div { white-space: nowrap; }
  .contacts i { color: var(--teal); margin-right: 6px; width: 1em; text-align: center; }
  .contacts a { color: var(--link); text-decoration: none; }

  /* ---------- sections ---------- */
  section { margin-top: 12px; }
  h2 {
    font-size: var(--fs-section); font-weight: 600; color: var(--teal); margin: 0 0 6px;
    padding-bottom: 2px; border-bottom: 1px solid var(--rule);
  }

  /* ---------- entries ---------- */
  .entry { margin-bottom: 8px; }
  .entry:last-child { margin-bottom: 0; }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  .entry-title { font-size: var(--fs-title); font-weight: 400; }     /* bigger than body -> stands out */
  .entry-title .co { font-weight: 700; }
  .entry-meta { color: var(--muted); font-size: var(--fs-meta); white-space: nowrap; }
  ul { margin: 2px 0 0; padding-left: 15px; }
  li { margin: 1.5px 0; text-align: left; }                        /* left-aligned (ragged right) so body text never runs into the right margin */
  .group-name { font-weight: 700; }

  /* ---------- skills (same font size as the work-experience bullets) ---------- */
  .skill-row { margin: 2.5px 0; font-size: var(--fs-body); }
  .skill-cat { font-weight: 700; }

  /* ---------- awards ---------- */
  .award { margin-bottom: 6px; }
  .award-head { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  .award-title { font-weight: 700; }
  .award-date { color: var(--muted); font-size: var(--fs-meta); white-space: nowrap; }
  .award-detail { font-size: var(--fs-body); }
</style>
</head>
<body>

  <header>
    <div class="header-left">
      <div class="name">{{ b.name }}</div>
      {% if b.title %}<div class="headline">{{ b.title }}</div>{% endif %}
    </div>
    <div class="contacts">
      {% for l in b.links %}
      <div>
        {% if l.network == 'LinkedIn' %}<i class="fa-brands fa-linkedin"></i>
        {% elif l.network == 'GitHub' %}<i class="fa-brands fa-github"></i>
        {% else %}<i class="fa-solid fa-link"></i>{% endif %}<a href="{{ l.url }}">{{ l.network }}</a>
      </div>
      {% endfor %}
      {% if b.email %}<div><i class="fa-solid fa-envelope"></i><a href="mailto:{{ b.email }}">{{ b.email }}</a></div>{% endif %}
      {% if b.phone %}<div><i class="fa-solid fa-phone"></i>{{ b.phone }}</div>{% endif %}
    </div>
  </header>

  {% if experience %}
  <section>
    <h2>Experience</h2>
    {% for e in experience %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title"><span class="co">{{ e.company }}</span>, {{ e.role }}</div>
        <div class="entry-meta">{{ e.start|mon }} &ndash; {{ e.end|mon }}</div>
      </div>
      {% if e.highlights %}<ul>{% for h in e.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
      {% if e.groups %}
      <ul>
        {% for g in e.groups %}
        <li><span class="group-name">{{ g.name }}</span> &mdash; {{ g.highlights[0] }}</li>
        {% for h in g.highlights[1:] %}<li>{{ h }}</li>{% endfor %}
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skills %}
  <section>
    <h2>Skills</h2>
    {% for s in skills %}
    <div class="skill-row"><span class="skill-cat">{{ s.category }}:</span> {{ s['items']|join(', ') }}</div>
    {% endfor %}
    {% if certifications %}
    <div class="skill-row"><span class="skill-cat">Certifications:</span> {{ certifications|join(', ') }}</div>
    {% endif %}
  </section>
  {% endif %}

  {% if awards %}
  <section>
    <h2>Awards and Recognition</h2>
    {% for a in awards %}
    <div class="award">
      <div class="award-head">
        <div class="award-title">{{ a.title }}</div>
        <div class="award-date">{{ a.date }}</div>
      </div>
      {% if a.detail %}<div class="award-detail">{{ a.detail }}</div>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

</body>
</html>
