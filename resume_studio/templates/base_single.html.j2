<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ b.name }} - Resume</title>
{{ font_links|safe }}
<style>
  :root {
    --accent: #1f5fa8;
    --accent2: #1f5fa8;
    --ink: #1a1a1a;
    --muted: #5b6470;
    --rule: #d9dee5;
    --subhead: #33404f;
    --body-font: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --head-font: var(--body-font);
    --name-font: var(--head-font);
    --name-size: 23pt;
    --name-weight: 700;
    --fs: 10.3pt;
    --lh: 1.38;
    --name-color: var(--accent);
    --hdr-border: 2px solid var(--accent);
    --h2-transform: uppercase;
    --h2-size: 10.5pt;
    --h2-spacing: 1.2px;
    --h2-weight: 700;
    --h2-color: var(--accent);
    --h2-border: 1px solid var(--rule);
    --h2-align: left;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: var(--body-font);
    color: var(--ink);
    font-size: var(--fs);
    line-height: var(--lh);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page { padding: 0; }

  header { border-bottom: var(--hdr-border); padding-bottom: 8px; margin-bottom: 12px; }
  .name {
    font-family: var(--name-font);
    font-size: var(--name-size); font-weight: var(--name-weight);
    color: var(--name-color); letter-spacing: .3px; line-height: 1.05;
  }
  .title { font-size: 11pt; color: var(--muted); margin-top: 2px; font-weight: 600; }
  .contact { margin-top: 6px; font-size: 9.4pt; color: var(--muted); }
  .contact a { color: var(--accent); text-decoration: none; }
  .contact .sep { color: var(--rule); margin: 0 7px; }
  .summary { margin: 10px 0 2px; color: var(--ink); }

  section { margin-top: 13px; }
  h2 {
    font-family: var(--head-font);
    font-size: var(--h2-size); text-transform: var(--h2-transform);
    letter-spacing: var(--h2-spacing); color: var(--h2-color);
    font-weight: var(--h2-weight); margin: 0 0 7px; text-align: var(--h2-align);
    border-bottom: var(--h2-border); padding-bottom: 3px;
  }

  .entry { margin-bottom: 10px; }
  .entry:last-child { margin-bottom: 0; }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .entry-title { font-weight: 700; }
  .entry-title .role { font-weight: 600; color: var(--ink); }
  .entry-meta { color: var(--muted); font-size: 9.2pt; white-space: nowrap; text-align: right; }
  ul { margin: 4px 0 0; padding-left: 16px; }
  li { margin: 2px 0; }
  .group { margin-top: 5px; }
  .group-name { font-weight: 700; font-size: 9.8pt; color: var(--subhead); }
  .group ul { margin-top: 1px; }

  .skill-row { display: flex; gap: 8px; margin: 3px 0; }
  .skill-cat { font-weight: 700; color: var(--subhead); flex: 0 0 135px; }
  .skill-items { flex: 1; }
  .chip:not(:last-child)::after { content: ", "; }
  .certs { margin-top: 5px; }
  .certs .skill-cat { display: inline; }

  .award { margin-bottom: 6px; }
  .award-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .award-title { font-weight: 700; }
  .award-date { color: var(--muted); font-size: 9.2pt; white-space: nowrap; }
  .award-detail { color: var(--ink); }

{{ theme_css|safe }}
</style>
</head>
<body>
<div class="page {{ body_class }}">

  <header>
    <div class="name">{{ b.name }}</div>
    {% if b.title %}<div class="title">{{ b.title }}</div>{% endif %}
    <div class="contact">
      {%- if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif -%}
      {%- if b.phone %}<span class="sep">|</span>{{ b.phone }}{% endif -%}
      {%- if b.location %}<span class="sep">|</span>{{ b.location }}{% endif -%}
      {%- for l in b.links %}<span class="sep">|</span><a href="{{ l.url }}">{{ l.url|striphttp }}</a>{% endfor -%}
    </div>
    {% if b.summary %}<div class="summary">{{ b.summary }}</div>{% endif %}
  </header>

  {% if experience %}
  <section>
    <h2>Work Experience</h2>
    {% for e in experience %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">{{ e.company }} <span class="role">/ {{ e.role }}</span></div>
        <div class="entry-meta">{{ e.start|mon }} &ndash; {{ e.end|mon }}{% if e.location %} &middot; {{ e.location }}{% endif %}</div>
      </div>
      {% if e.highlights %}<ul>{% for h in e.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
      {% if e.groups %}{% for g in e.groups %}
      <div class="group">
        <div class="group-name">{{ g.name }}</div>
        <ul>{% for h in g.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
      </div>
      {% endfor %}{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skills %}
  <section>
    <h2>Skills</h2>
    {% for s in skills %}
    <div class="skill-row">
      <div class="skill-cat">{{ s.category }}</div>
      <div class="skill-items">{% for it in s['items'] %}<span class="chip">{{ it }}</span>{% endfor %}</div>
    </div>
    {% endfor %}
    {% if certifications %}
    <div class="skill-row certs">
      <div class="skill-cat">Certifications</div>
      <div class="skill-items">{% for c in certifications %}<span class="chip">{{ c }}</span>{% endfor %}</div>
    </div>
    {% endif %}
  </section>
  {% endif %}

  {% if education %}
  <section>
    <h2>Education</h2>
    {% for e in education %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">{{ e.institution }}{% if e.degree %} <span class="role">/ {{ e.degree }}{% if e.area %}, {{ e.area }}{% endif %}</span>{% endif %}</div>
        <div class="entry-meta">{{ e.start|mon }} &ndash; {{ e.end|mon }}{% if e.location %} &middot; {{ e.location }}{% endif %}</div>
      </div>
      {% if e.highlights %}<ul>{% for h in e.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if awards %}
  <section>
    <h2>Awards &amp; Recognition</h2>
    {% for a in awards %}
    <div class="award">
      <div class="award-head">
        <div class="award-title">{{ a.title }}</div>
        <div class="award-date">{{ a.date }}</div>
      </div>
      {% if a.detail %}<div class="award-detail">{{ a.detail }}</div>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

</div>
</body>
</html>
